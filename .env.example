# Application

APP_ENV=development
ALLOW_EVALUATION_FIXTURES=false


# LLM

MODEL_PROVIDER=ollama
MODEL_NAME=your-installed-model-name
MODEL_BASE_URL=http://host.docker.internal:11434
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=1
MODEL_MAX_CONCURRENCY=2
MAX_TOOL_CALLS_PER_REQUEST=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=30
DATABASE_MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4.0
HEALTH_CHECK_TIMEOUT_SECONDS=5.0
LOG_LEVEL=INFO


# Database

DATABASE_URL=postgresql+psycopg2://enterprise_user:change-me@localhost:5432/enterprise_ai
ASYNC_DATABASE_URL=postgresql+asyncpg://enterprise_user:change-me@localhost:5432/enterprise_ai
LANGGRAPH_DATABASE_URL=postgresql://enterprise_user:change-me@localhost:5432/enterprise_ai
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=enterprise_ai
DATABASE_USER=enterprise_user
DATABASE_PASSWORD=change-me
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS='["http://localhost:8501"]'
MAX_REQUEST_BYTES=65536


# Redis

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=30
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=5
JOB_RATE_LIMIT_REQUESTS=5
APPROVAL_RATE_LIMIT_REQUESTS=10


# Kafka

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions


# AWS

AWS_REGION=us-east-1
S3_BUCKET_NAME=placeholder


# Security

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

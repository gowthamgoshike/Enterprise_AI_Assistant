# Application

APP_ENV=development


# LLM

LLM_PROVIDER=ollama
LLM_MODEL=placeholder
LLM_REQUEST_TIMEOUT_SECONDS=120
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
TOOL_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=30
DATABASE_MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4.0
HEALTH_CHECK_TIMEOUT_SECONDS=5.0


# Database

DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_ai


# Redis

REDIS_URL=redis://localhost:6379


# Kafka

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions


# AWS

AWS_REGION=us-east-1
S3_BUCKET_NAME=placeholder


# Security

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

LANGGRAPH_DATABASE_URL=postgresql://postgres:password@localhost:5432/enterprise_db
